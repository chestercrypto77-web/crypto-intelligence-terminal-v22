# LEGACY V22.0 RENDER ARTIFACT — DO NOT DEPLOY FOR V22.1 FREE-FIRST ARCHITECTURE
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements-v22.txt .
RUN pip install --no-cache-dir -r requirements-v22.txt
COPY . .
CMD ["python","-m","v22.brain.supervisor"]
